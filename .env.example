# Provider key for the model in EXTRACT_MODEL (any LiteLLM-supported provider)
GEMINI_API_KEY=<REPLACE_ME>
OPENROUTER_API_KEY=<REPLACE_ME>
# OPENAI_API_KEY=<REPLACE_ME>
# ANTHROPIC_API_KEY=<REPLACE_ME>

# LiteLLM model strings. EXTRACT_MODEL is the default for `run` and the first model in `grid`.
EXTRACT_MODEL=gemini/gemini-2.5-flash
# Optional. Comma-separated LiteLLM strings. `grid` runs each of these after EXTRACT_MODEL.
# EXTRA_EXTRACT_MODELS=openai/gpt-4o-mini,anthropic/claude-3-5-haiku-latest
LOCAL_MODEL=ollama_chat/qwen2.5:3b
OLLAMA_API_BASE=http://localhost:11434